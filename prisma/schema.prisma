// Schema referencial de prisma a la db

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(uuid())
  name         String @map("nombre")
  username     String @unique
  email        String @unique
  passwordHash String @map("password_hash")

  groupMemberships    GroupMember[]
  eventParticipations EventParticipant[]
  organizedEvents     Event[]            @relation("EventOrganizer")

  @@map("usuario")
}

model GroupMember {
  userId  String @map("usuario_id")
  groupId String @map("grupo_id")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
  @@map("miembro_grupo")
}

model Group {
  id   String @id @default(uuid())
  name String @map("nombre")

  events  Event[]
  members GroupMember[]

  @@map("grupo")
}

model Event {
  id      String @id @default(uuid())
  groupId String @map("grupo_id")
  name    String @map("nombre")
  status  String @default("active") @map("estado")

  organizerId String   @map("creado_por_usuario_id")
  location    String   @map("lugar_texto")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  group        Group              @relation(fields: [groupId], references: [id])
  organizer    User               @relation("EventOrganizer", fields: [organizerId], references: [id])
  participants EventParticipant[]
  invitations  Invitation[]

  @@map("evento")
}

model Invitation {
  id          String    @id @default(uuid())
  eventId     String    @map("evento_id")
  uniqueToken String    @unique @map("token_unico")
  expiresAt   DateTime? @map("expira_en")
  status      String    @default("active") @map("estado")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("invitaciones")
}

model EventParticipant {
  id          String  @id @default(uuid())
  eventId     String  @map("evento_id")
  userId      String? @map("usuario_id")
  username    String
  isAnonymous Boolean @default(false) @map("es_anonimo")
  isOrganizer Boolean @default(false) @map("es_organizador")
  pinHash     String? @map("pin_hash")

  event             Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendanceState   AttendanceState    @default(not_confirmed) @map("attendance_state")
  availabilitySlots AvailabilitySlot[]

  @@unique([eventId, username])
  @@index([eventId])
  @@index([userId])
  @@map("participante")
}

model AvailabilitySlot {
  id            String @id @default(uuid())
  participantId String @map("participante_id")
  eventId       String @map("evento_id")
  weekDay       Int    @map("week_day")
  hourBlock     Int    @map("hour_block")

  participant EventParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, eventId, weekDay, hourBlock])
  @@index([participantId, eventId])
  @@map("availability_slot")
}

enum AttendanceState {
  not_confirmed
  confirmed
  rejected
}
