// Schema referencial de prisma a la db

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(uuid())
  name         String @map("nombre")
  username     String @unique
  email        String @unique
  passwordHash String @map("password_hash")

  groupMemberships    GroupMember[]
  eventParticipations EventParticipant[]
  organizedEvents     Event[]            @relation("EventOrganizer")

  @@map("usuario")
}

model GroupMember {
  userId  String @map("usuario_id")
  groupId String @map("grupo_id")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
  @@map("miembro_grupo")
}

model Group {
  id   String @id @default(uuid())
  name String @map("nombre")

  events  Event[]
  members GroupMember[]

  @@map("grupo")
}

model Event {
  id      String @id @default(uuid())
  groupId String @map("grupo_id")
  name    String @map("nombre")
  status  String @default("active") @map("estado")

  organizerId String   @map("creado_por_usuario_id")
  location    String   @map("lugar_texto")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  group        Group              @relation(fields: [groupId], references: [id])
  organizer    User               @relation("EventOrganizer", fields: [organizerId], references: [id])
  participants EventParticipant[]

  @@map("evento")
}

model EventParticipant {
  id          String  @id @default(uuid())
  eventId     String  @map("evento_id")
  userId      String? @map("usuario_id")
  username    String
  isAnonymous Boolean @default(false) @map("es_anonimo")
  isOrganizer Boolean @default(false) @map("es_organizador")
  pinHash     String? @map("pin_hash")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([eventId, username])
  @@index([eventId])
  @@index([userId])
  @@map("participante")
}
