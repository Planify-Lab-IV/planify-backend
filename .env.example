NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>?schema=public
CORS_ORIGIN=https://tu-frontend.com
JWT_SECRET=clave_secreta_super_segura_de_mas_de_32_caracteres_12345
INTERNAL_KPIS_TOKEN=token_interno_exclusivo_de_kpis_de_al_menos_32_caracteres
# FIREBASE_SERVICE_ACCOUNT_BASE64=<JSON_de_cuenta_de_servicio_codificado_en_base64>
HOST_PORT=80

# Los avatares usan almacenamiento local fuera de producción por defecto.
# Para S3, configurar las tres variables siguientes. No agregar claves AWS:
# el SDK usa el rol IAM de la instancia en producción.

# AVATAR_STORAGE=s3
# AVATAR_S3_BUCKET=planify-avatars
# AWS_REGION=us-east-1

# En local, la recuperación de contraseña usa la consola y no requiere SMTP.
# Para habilitar el envío real en producción, descomentar y completar estas variables.
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=planify.notificaciones@gmail.com
# SMTP_PASS=contraseña_de_aplicacion_de_gmail
# MAIL_FROM=Planify <planify.notificaciones@gmail.com>

