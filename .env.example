NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>?schema=public
CORS_ORIGIN=https://tu-frontend.com
JWT_SECRET=clave_secreta_super_segura_de_mas_de_32_caracteres_12345
HOST_PORT=80

# Los avatares usan almacenamiento local fuera de producción por defecto.
# Para S3, configurar las tres variables siguientes. No agregar claves AWS:
# el SDK usa el rol IAM de la instancia en producción.

AVATAR_STORAGE=s3
AVATAR_S3_BUCKET=planify-avatars
AWS_REGION=us-east-1
